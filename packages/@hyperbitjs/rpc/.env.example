# Generic JSON-RPC environment variables
# Copy to .env and fill in your credentials

# Required RPC endpoint URL
RPC_URL=http://127.0.0.1:8545

# Node RPC auth
RPC_USER=rpcuser
RPC_PASSWORD=rpcpassword

# Optional client tuning
# RPC_TIMEOUT=20000
# RPC_RETRIES=1
# RPC_RETRY_DELAY=750
# RPC_LOG_LEVEL=warn
