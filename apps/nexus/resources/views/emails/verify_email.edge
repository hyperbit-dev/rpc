@mjml()
<mjml>
    <mj-head>
        <mj-title>Verify Your Email</mj-title>
        <mj-attributes>
            <mj-all font-family="Arial, sans-serif" />
            <mj-text align="center" font-size="16px" />
            <mj-button background-color="#0044cc" color="#ffffff" border-radius="5px" font-size="16px" />
        </mj-attributes>
    </mj-head>

    <mj-body background-color="#f4f4f4">

        <!-- Outer Container -->
        <mj-section background-color="#ffffff" padding="20px" border-radius="8px" margin="0 auto"
            border="1px solid #e0e0e0">

            <!-- Header with Logo -->
            <mj-column>
                <mj-text font-size="24px" background-color="#0044cc" padding="16px 0">
                    Welcome to Hyperbit
                </mj-text>
                <mj-text>
                    Thanks for signing up with Hyperbit! To complete your registration, please verify your
                    email address by clicking the button below.
                </mj-text>

                <mj-button href="{{ verificationUrl }}" align="center">
                    Verify Email
                </mj-button>

                <mj-text>
                    If the button above doesn&apos;t work, copy and paste this link into your browser:
                    <br />
                    <a href="{{ verificationUrl }}">{{ verificationUrl }}</a>
                </mj-text>

                <mj-text font-size="14px" color="#777777">
                    If you didn&apos;t create an account, you can safely ignore this email.
                    <br /><br />
                    &copy; {{ new Date().getFullYear() }} Hyperbit. All rights reserved.
                    <br />
                    <a href="https://hyperbit.app">Visit our website</a>
                </mj-text>
            </mj-column>

        </mj-section>
    </mj-body>
</mjml>
@end