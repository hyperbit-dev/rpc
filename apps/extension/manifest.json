{
  "manifest_version": 3,
  "name": "Hyperbit",
  "version": "1.0.0",
  "action": { "default_popup": "index.html" },
    "content_scripts": [
    {
      "js": ["src/main.tsx"],
      "matches": ["https://google.com/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage"]
}
