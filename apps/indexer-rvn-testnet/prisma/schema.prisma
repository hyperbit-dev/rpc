// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Block {
  id                Int           @id @default(autoincrement())
  hash              String        @unique
  confirmations     Int?
  size              Int
  strippedsize      Int
  weight            Int
  height            Int           @unique
  version           Int
  versionHex        String
  merkleroot        String
  tx                Transaction[]
  time              BigInt
  mediantime        BigInt
  nonce             BigInt
  bits              String
  difficulty        Int
  chainwork         String
  headerhash        String?
  mixhash           String?
  previousblockhash String?
  nextblockhash     String
}

model Transaction {
  id            Int    @id @default(autoincrement())
  hash          String @unique
  version       Int
  size          Int
  vsize         Int
  locktime      Int
  vin           Vin[]
  vout          Vout[]
  hex           String @db.Text
  blockhash     String?
  height        BigInt?
  confirmations Int?
  time          BigInt?
  Block         Block? @relation(fields: [blockId], references: [id])
  blockId       Int?
}

model Vin {
  id            Int          @id @default(autoincrement())
  coinbase      String?
  sequence      BigInt
  txid          String?
  vout          Int?
  scriptSig     Json?
  value         Float?
  valueSat      BigInt?
  address       String?
  Transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId Int?
}

model Vout {
  id            Int          @id @default(autoincrement())
  n             Int
  scriptPubKey  Json
  valueSat      BigInt?
  Transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId Int?
}

model Address {
  id       Int    @id @default(autoincrement())
  address  String
  balance  Int?
  received Int?
}

model Asset {
  id         Int     @id @default(autoincrement())
  name       String
  amount     Int
  units      Int
  reissuable Boolean
  has_ipfs   Boolean
}
