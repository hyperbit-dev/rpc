// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Block {
  id                Int    @id @default(autoincrement())
  hash              String @unique
  confirmations     Int
  size              Int
  strippedsize      Int
  weight            Int
  height            Int
  version           Int
  versionHex        String
  merkleroot        String
  // tx TODO
  time              Int
  mediantime        Int
  nonce             Int
  bits              String
  difficulty        Int
  chainwork         String
  previousblockhash String
  nextblockhash     String
}

