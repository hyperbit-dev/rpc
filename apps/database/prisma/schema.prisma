model Wallet {
  id            String          @id @default(uuid())
  name          String?
  blockchainId  String
  blockchain    Blockchain      @relation(fields: [blockchainId], references: [id])
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  passphrase    String? // hashed
  active        Boolean         @default(true)
  favorite      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  deletedAt     DateTime?
  WalletAccount WalletAccount[]
}

model WalletAccount {
  id            String          @id @default(uuid())
  index         Int
  label         String?
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  deletedAt     DateTime?
  WalletAddress WalletAddress[]

  @@unique([index, walletId])
}

model WalletAddress {
  id              String        @id @default(uuid())
  address         String
  label           String?
  path            String?
  walletAccountId String
  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  deletedAt       DateTime?

  @@unique([address, walletAccountId])
}

