{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:app": "turbo run build --filter=\"./apps/app\"",
    "build:web": "turbo run build --filter=\"./apps/web\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "eslint": "^9.4.0",
    "prettier": "^3.3.2",
    "tsconfig": "*",
    "turbo": "latest"
  },
  "name": "hyperbit",
  "packageManager": "npm@8.19.3",
  "overrides": {
    "follow-redirects": "^1.15.6",
    "lodash": "^4.17.19",
    "lodash-es": "^4.17.20",
    "cipher-base": "^1.0.7",
    "sha.js": "^2.4.12",
    "node-forge": "^1.4.0",
    "pbkdf2": "^3.1.7",
    "handlebars": "^4.7.10",
    "axios": "^1.20.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "20.x"
  }
}
