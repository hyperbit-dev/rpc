{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:app": "turbo run build --filter=\"./apps/app\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "prettier": "^3.0.3",
    "tsconfig": "*",
    "turbo": "latest"
  },
  "name": "hyperbit",
  "packageManager": "npm@8.19.3",
  "overrides": {
    "follow-redirects": "^1.15.6",
    "lodash": "^4.17.19",
    "lodash-es": "^4.17.20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
